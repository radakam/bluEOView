# Source maps are not emitted for the production build.
#
# CRA runs source-map-loader over node_modules, and plotly.js ships dist files
# whose sourceMappingURL comments point at .map files it does not publish, so
# every build warned about maplibre-gl, mapbox-gl and three others it cannot
# find. This flag drops that loader (react-scripts webpack.config.js:353).
#
# The development server is unaffected: it derives its own source maps from our
# code through devtool, independently of this setting.
GENERATE_SOURCEMAP=false
